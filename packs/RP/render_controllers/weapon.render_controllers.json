{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.jm_weapon_first_person": {
      "geometry": "geometry.first_person",
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "texture.default",
        "texture.enchanted"
      ]
    },
    "controller.render.jm_weapon_third_person": {
      "geometry": "geometry.third_person",
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "texture.default",
        "texture.enchanted"
      ]
    }
  }
}
