{
    "format_version": "1.10.0",
    "minecraft:attachable": {
        "description": {
            "identifier": "minecraft:stone_axe",
            "materials": {
                "default": "entity_alphatest",
                "enchanted": "entity_alphatest_glint"
            },
            "textures": {
                "default": "textures/items/stone_axe",
                "enchanted": "textures/misc/enchanted_item_glint"
            },
            "geometry": {
                "first_person": "geometry.jm.weapon.axe.fp",
                "third_person": "geometry.jm.weapon.axe.tp"
            },
            "animations": {
                "detached": "animation.jm.detached.rightitem_base_pose",
                "resting": "animation.jm.resting.axe"
            },
            "scripts": {
                "parent_setup": "c.item_slot == 'main_hand' ? { v.use_attachable_animations_main_hand = 1.0; } : { v.use_attachable_animations_off_hand = 1.0; };",
                "animate": [
                    {
                        "detached": "c.is_first_person"
                    },
                    "resting"
                ]
            },
            "render_controllers": [
                {
                    "controller.render.jm_weapon_first_person": "c.is_first_person"
                },
                {
                    "controller.render.jm_weapon_third_person": "!c.is_first_person"
                }
            ]
        }
    }
}
